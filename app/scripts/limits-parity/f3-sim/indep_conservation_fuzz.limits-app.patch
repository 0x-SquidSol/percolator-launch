+// ---------------------------------------------------------------------------------------------
+// limits-UI lane (percolator-launch feat/limits-ui, F-3 / R1): the SAME scenario, but every
+// holder's exit is the APP-BUILT transaction — the instructions come verbatim from the app's
+// `buildRebalanceCloseIxs` (app/lib/limits/rebalance-ixs.ts) via
+// `app/scripts/limits-parity/f3-app-ixs.ts` (spawned with tsx). The app sends
+// [PermissionlessCrank(own portfolio), RebalanceReduce(|position|)] in ONE owner-signed tx; the
+// keeper's AuthMark push is the harness's. Requires LIMITS_APP_DIR (the app/ dir) and TSX_BIN.
+// ---------------------------------------------------------------------------------------------
+
+use solana_sdk::{instruction::Instruction, transaction::Transaction};
+
+fn limits_app_ixs(program: Pubkey, market: Pubkey, owner: Pubkey, port: Pubkey, pid: u64, pep: u64, reduce_q: u128) -> Vec<Instruction> {
+    let app = std::env::var("LIMITS_APP_DIR").expect("LIMITS_APP_DIR (percolator-launch app/ dir)");
+    let tsx = std::env::var("TSX_BIN").expect("TSX_BIN");
+    let out = std::process::Command::new(tsx)
+        .current_dir(&app)
+        .args(["--tsconfig", "tsconfig.json", "scripts/limits-parity/f3-app-ixs.ts"])
+        .args([program.to_string(), market.to_string(), owner.to_string(), port.to_string(), pid.to_string(), pep.to_string(), reduce_q.to_string()])
+        .output()
+        .expect("spawn app builder");
+    assert!(out.status.success(), "app builder failed: {}", String::from_utf8_lossy(&out.stderr));
+    let v: serde_json::Value = serde_json::from_slice(&out.stdout).expect("app builder json");
+    v.as_array()
+        .expect("array")
+        .iter()
+        .map(|ix| {
+            let hex = ix["dataHex"].as_str().unwrap();
+            let data = (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect();
+            let accounts = ix["keys"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|k| {
+                    let pk: Pubkey = k["pubkey"].as_str().unwrap().parse().unwrap();
+                    if k["isWritable"].as_bool().unwrap() {
+                        AccountMeta::new(pk, k["isSigner"].as_bool().unwrap())
+                    } else {
+                        AccountMeta::new_readonly(pk, k["isSigner"].as_bool().unwrap())
+                    }
+                })
+                .collect();
+            Instruction { program_id: ix["programId"].as_str().unwrap().parse().unwrap(), accounts, data }
+        })
+        .collect()
+}
+
+/// |basis| of the holder's asset-0 leg, read from the raw portfolio bytes exactly as the app's
+/// `signedPositionForAsset` does (first active leg with asset_index 0; +16 header, legs @340,
+/// stride 152, active @0, asset u32 @1, basis i128 @14).
+fn limits_abs_position(w: &World, u: usize) -> u128 {
+    let d = w.env.svm.get_account(&w.ports[u]).expect("portfolio").data;
+    for s in 0..16 {
+        let l = 16 + 340 + s * 152;
+        if d[l] == 1 && u32::from_le_bytes(d[l + 1..l + 5].try_into().unwrap()) == 0 {
+            return i128::from_le_bytes(d[l + 14..l + 30].try_into().unwrap()).unsigned_abs();
+        }
+    }
+    0
+}
