+#[test]
+fn f3_app_built_owner_exits_reopen_market_after_single_bankruptcy() {
+    let mut w = f3_state_after_single_bankruptcy();
+    let (_, g) = w.env.market_state();
+    assert!(g.assets[0].a_short < percolator::ADL_ONE || g.assets[0].a_long < percolator::ADL_ONE, "scenario must be ADL reduce-only");
+    // u2 is SHORT like the LP (u4): the matcher close is refused 21 — the app must not need it.
+    f3_refresh(&mut w, &[2]);
+    assert_eq!(w.do_trade_cpi(2, POS_SCALE as i128).map_err(|e| custom_code(&e)), Err(Some(21)), "matcher close is the F-3 dead end");
+    let program = w.env.program_id;
+    let market = w.env.market;
+    let mut app_exits = 0usize;
+    for _ in 0..4 {
+        let holders: Vec<usize> = (0..w.ports.len()).filter(|&u| !w.closed[u] && f3_has_position(&w, u)).collect();
+        if holders.is_empty() {
+            break;
+        }
+        for u in holders {
+            // keeper: fresh AuthMark; the crank is inside the app's own tx.
+            let s = w.slot() + 1;
+            w.env.svm.warp_to_slot(s);
+            let _ = w.do_push(w.mark);
+            let owner = w.owners[u].insecure_clone();
+            let port = w.ports[u];
+            let (pid, _, pep) = w.env.portfolio_identity(port);
+            let q = limits_abs_position(&w, u);
+            if q == 0 {
+                continue;
+            }
+            let ixs = limits_app_ixs(program, market, owner.pubkey(), port, pid, pep, q);
+            assert_eq!(ixs.len(), 2);
+            assert_eq!(ixs[1].data[0], 44, "app tx ends with RebalanceReduce");
+            let mut all = vec![heap_ix(), cu_ix()];
+            all.extend(ixs);
+            w.env.svm.expire_blockhash();
+            let tx = Transaction::new_signed_with_payer(&all, Some(&w.env.payer.pubkey()), &[&w.env.payer, &owner], w.env.svm.latest_blockhash());
+            let r = w.env.svm.send_transaction(tx).map_err(|e| format!("{e:?}"));
+            if std::env::var("F3_TRACE").is_ok() {
+                eprintln!("LIMITS-APP u{u} q={q} -> {:?}", r.as_ref().map(|m| m.compute_units_consumed).map_err(|e| custom_code(e)));
+            }
+            if r.is_ok() {
+                app_exits += 1;
+            }
+        }
+        let _ = w.permissionless_repair(3);
+    }
+    let left = (0..w.ports.len()).filter(|&u| !w.closed[u] && f3_has_position(&w, u)).count();
+    assert_eq!(left, 0, "every holder must exit with the app-built owner-signed tx");
+    assert!(app_exits >= 1, "at least one app-built exit landed");
+    assert!(w.is_flat(2), "the same-side-as-LP trader exited without the matcher");
+    let (_, g) = w.env.market_state();
+    assert_eq!((g.assets[0].oi_eff_long_q, g.assets[0].oi_eff_short_q), (0, 0));
+    assert_eq!((g.assets[0].a_long, g.assets[0].a_short), (percolator::ADL_ONE, percolator::ADL_ONE));
+    w.check().unwrap();
+    w.probe_recovered().expect("market must reopen after the app-built exits");
+    w.check().unwrap();
+}
