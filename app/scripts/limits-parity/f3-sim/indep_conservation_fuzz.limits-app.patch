+// ── E2E B10 (limits-UI lane): the APP's own B10 route, no keeper/harness repair between exits ──
+struct LimitsB10 { plain: Vec<Instruction>, candidates: Vec<(String, bool, Vec<Instruction>)> }
+
+fn limits_parse_ixs(v: &serde_json::Value) -> Vec<Instruction> {
+    v.as_array().expect("ixs").iter().map(|ix| {
+        let hex = ix["dataHex"].as_str().unwrap();
+        let data = (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect();
+        let accounts = ix["keys"].as_array().unwrap().iter().map(|k| {
+            let pk: Pubkey = k["pubkey"].as_str().unwrap().parse().unwrap();
+            let s = k["isSigner"].as_bool().unwrap();
+            if k["isWritable"].as_bool().unwrap() { AccountMeta::new(pk, s) } else { AccountMeta::new_readonly(pk, s) }
+        }).collect();
+        Instruction { program_id: ix["programId"].as_str().unwrap().parse().unwrap(), accounts, data }
+    }).collect()
+}
+
+fn limits_b10(program: Pubkey, market: Pubkey, owner: Pubkey, port: Pubkey, pid: u64, pep: u64, q: u128, ml: u8, ms: u8) -> LimitsB10 {
+    let app = std::env::var("LIMITS_APP_DIR").expect("LIMITS_APP_DIR");
+    let tsx = std::env::var("TSX_BIN").expect("TSX_BIN");
+    let out = std::process::Command::new(tsx).current_dir(&app)
+        .args(["--tsconfig", "tsconfig.json", "scripts/limits-parity/f3-app-b10.ts"])
+        .args([program.to_string(), market.to_string(), owner.to_string(), port.to_string(), pid.to_string(), pep.to_string(), q.to_string(), ml.to_string(), ms.to_string()])
+        .output().expect("spawn app b10 builder");
+    assert!(out.status.success(), "app b10 builder failed: {}", String::from_utf8_lossy(&out.stderr));
+    let v: serde_json::Value = serde_json::from_slice(&out.stdout).unwrap();
+    LimitsB10 {
+        plain: limits_parse_ixs(&v["plain"]),
+        candidates: v["candidates"].as_array().unwrap().iter()
+            .map(|c| (c["route"].as_str().unwrap().to_string(), c["needsFlatAfter"].as_bool().unwrap(), limits_parse_ixs(&c["ixs"]))).collect(),
+    }
+}
+
+/// app `A_MODE_LONG/SHORT` = engine asset view +513/+514, engine slot = 592 + 758 + 1024 for asset 0.
+fn limits_side_modes(w: &World) -> (u8, u8) {
+    let d = w.env.svm.get_account(&w.env.market).unwrap().data;
+    let e = 592 + 758 + 1024;
+    (d[e + 513], d[e + 514])
+}
+
+fn limits_run_b10(apply_candidates: bool, keeper_cranks: bool) -> (Vec<String>, usize, World) {
+    let mut w = f3_state_after_single_bankruptcy();
+    let program = w.env.program_id;
+    let market = w.env.market;
+    let mut log = Vec::new();
+    for pass in 0..3 {
+        let holders: Vec<usize> = (0..w.ports.len()).filter(|&u| !w.closed[u] && f3_has_position(&w, u)).collect();
+        if holders.is_empty() { break; }
+        for u in holders {
+            let s = w.slot() + 1;
+            w.env.svm.warp_to_slot(s);
+            let _ = w.do_push(w.mark); // keeper's AuthMark only — NO crank / finalize repair
+            let owner = w.owners[u].insecure_clone();
+            let port = w.ports[u];
+            let (pid, _, pep) = w.env.portfolio_identity(port);
+            let q = limits_abs_position(&w, u);
+            if q == 0 { continue; }
+            let (ml, ms) = limits_side_modes(&w);
+            let app = limits_b10(program, market, owner.pubkey(), port, pid, pep, q, ml, ms);
+            let mk = |w: &mut World, ixs: &Vec<Instruction>| {
+                let mut all = vec![heap_ix(), cu_ix()];
+                all.extend(ixs.clone());
+                w.env.svm.expire_blockhash();
+                Transaction::new_signed_with_payer(&all, Some(&w.env.payer.pubkey()), &[&w.env.payer, &owner], w.env.svm.latest_blockhash())
+            };
+            // the app's rule: plain first
+            let tx = mk(&mut w, &app.plain);
+            let sim = w.env.svm.simulate_transaction(tx.clone().into());
+            let trapped = match &sim { Err(e) => {
+                let es = format!("{e:?}");
+                (es.contains("InstructionError(3, Custom(18))") || es.contains("InstructionError(3, Custom(22))"))
+            } Ok(_) => false };
+            if sim.is_ok() {
+                w.env.svm.send_transaction(tx).expect("plain sim ok but send failed");
+                log.push(format!("p{pass} u{u}: tag44"));
+                continue;
+            }
+            if !apply_candidates || !trapped {
+                log.push(format!("p{pass} u{u}: plain {:?}", sim.err().map(|e| custom_code(&format!("{e:?}")))));
+                continue;
+            }
+            let mut done = false;
+            for (route, needs_flat, ixs) in &app.candidates {
+                let tx = mk(&mut w, ixs);
+                if w.env.svm.simulate_transaction(tx.clone().into()).is_err() { continue; }
+                w.env.svm.send_transaction(tx).expect("candidate sim ok but send failed");
+                if *needs_flat {
+                    assert!(w.is_flat(u), "B10 candidate {route} landed but the leg is not flat: the app would have skipped it");
+                }
+                log.push(format!("p{pass} u{u}: {route}"));
+                done = true;
+                break;
+            }
+            if !done { log.push(format!("p{pass} u{u}: TRAPPED, no candidate")); }
+        }
+        if keeper_cranks {
+            // a keeper that cranks every portfolio but never sends FinalizeResetSide
+            for u in 0..w.ports.len() { if !w.closed[u] { let _ = w.do_crank(u); } }
+        }
+    }
+    let left = (0..w.ports.len()).filter(|&u| !w.closed[u] && f3_has_position(&w, u)).count();
+    (log, left, w)
+}
+
+#[test]
+fn b10_app_exits_after_one_side_drained() {
+    let (log, left, mut w) = limits_run_b10(true, false);
+    eprintln!("B10 app route: {log:?}");
+    assert_eq!(left, 0, "every holder exits with the APP's own txs, no keeper repair: {log:?}");
+    assert!(log.iter().any(|l| !l.ends_with(": tag44")), "the scenario must exercise a B10 candidate: {log:?}");
+    let (_, g) = w.env.market_state();
+    assert_eq!((g.assets[0].a_long, g.assets[0].a_short), (percolator::ADL_ONE, percolator::ADL_ONE));
+    let (ml, ms) = limits_side_modes(&w);
+    assert_eq!((ml, ms), (0, 0), "the app's last exit finalized the drained side (no 45 needed from anyone)");
+    w.check().unwrap();
+    w.probe_recovered().expect("market reopens with NO keeper/harness repair");
+    w.check().unwrap();
+}
+
+/// Same, with a keeper that cranks everyone between passes but never finalizes (E2E shape).
+#[test]
+fn b10_app_exits_with_crank_only_keeper() {
+    let (log, left, mut w) = limits_run_b10(true, true);
+    eprintln!("B10 app route (crank-only keeper): {log:?}");
+    assert_eq!(left, 0, "{log:?}");
+    let (ml, ms) = limits_side_modes(&w);
+    assert_eq!((ml, ms), (0, 0), "drained side finalized by an app tx: {log:?}");
+    w.check().unwrap();
+    w.probe_recovered().expect("market reopens");
+}
+
+/// NEGATIVE CONTROL: the plain [crank, 44] alone (round-3 behaviour) leaves holders trapped.
+#[test]
+fn b10_control_plain_exit_alone_traps_the_other_side() {
+    let (log, left, _) = limits_run_b10(false, false);
+    eprintln!("B10 plain only: {log:?}");
+    assert!(left > 0, "without the B10 route a holder must be stuck: {log:?}");
+    assert!(log.iter().any(|l| l.contains("Some(18)") || l.contains("Some(22)")), "{log:?}");
+}
