+// ═══════════════════════════════════════════════════════════════════════════════════════
+// limits-UI lane (percolator-launch feat/limits-ui, round 4): the P3 journey with every
+// instruction the APP sends built by the APP — spawned from
+// app/scripts/limits-parity/p3-app-ixs.ts, which calls the same lib functions the hooks use
+// (buildP3BindIxs, earnTxPlan + buildEarnDepositIxs / buildEarnExecuteIxs, planResolvedExit +
+// exitStepIxs on RAW account bytes). Protocol-only steps (99 / 95), the trader's trades and
+// ResolveMarket are the harness's. Requires LIMITS_APP_DIR and TSX_BIN.
+// ═══════════════════════════════════════════════════════════════════════════════════════
+
+const LIMITS_ATA_PROGRAM: Pubkey = solana_sdk::pubkey!("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL");
+
+fn limits_b64(b: &[u8]) -> String {
+    const T: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut s = String::new();
+    for c in b.chunks(3) {
+        let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32;
+        s.push(T[(n >> 18) as usize & 63] as char);
+        s.push(T[(n >> 12) as usize & 63] as char);
+        s.push(if c.len() > 1 { T[(n >> 6) as usize & 63] as char } else { '=' });
+        s.push(if c.len() > 2 { T[n as usize & 63] as char } else { '=' });
+    }
+    s
+}
+
+fn limits_app(cmd: &str, args: serde_json::Value) -> serde_json::Value {
+    let app = std::env::var("LIMITS_APP_DIR").expect("LIMITS_APP_DIR (percolator-launch app/ dir)");
+    let tsx = std::env::var("TSX_BIN").expect("TSX_BIN");
+    let out = std::process::Command::new(tsx)
+        .current_dir(&app)
+        .args(["--tsconfig", "tsconfig.json", "scripts/limits-parity/p3-app-ixs.ts", cmd, &args.to_string()])
+        .output()
+        .expect("spawn app builder");
+    assert!(out.status.success(), "app builder {cmd} failed: {}", String::from_utf8_lossy(&out.stderr));
+    serde_json::from_slice(&out.stdout).expect("app builder json")
+}
+
+fn limits_ixs(v: &serde_json::Value) -> Vec<Instruction> {
+    v["ixs"]
+        .as_array()
+        .expect("ixs")
+        .iter()
+        .map(|ix| {
+            let hex = ix["dataHex"].as_str().unwrap();
+            let data = (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect();
+            let accounts = ix["keys"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|k| {
+                    let pk: Pubkey = k["pubkey"].as_str().unwrap().parse().unwrap();
+                    let s = k["isSigner"].as_bool().unwrap();
+                    if k["isWritable"].as_bool().unwrap() { AccountMeta::new(pk, s) } else { AccountMeta::new_readonly(pk, s) }
+                })
+                .collect();
+            Instruction { program_id: ix["programId"].as_str().unwrap().parse().unwrap(), accounts, data }
+        })
+        .collect()
+}
+
+impl Env {
+    fn limits_add_ata_program(&mut self) {
+        let mut p = spl_token_program_path();
+        p.set_file_name("spl_associated_token_account-1.1.1.so");
+        self.svm.add_program(LIMITS_ATA_PROGRAM, &std::fs::read(p).expect("ATA BPF"));
+    }
+    fn limits_b64_of(&self, k: &Pubkey) -> String {
+        limits_b64(&self.svm.get_account(k).map(|a| a.data).unwrap_or_default())
+    }
+    /// Send APP instructions (fee payer = harness payer) and book the SPL vault delta into the
+    /// conservation counters.
+    fn limits_send(&mut self, ixs: Vec<Instruction>, extra: &[&Keypair]) -> Result<(), String> {
+        let mut instructions = vec![
+            ComputeBudgetInstruction::request_heap_frame(128 * 1024),
+            ComputeBudgetInstruction::set_compute_unit_limit(1_400_000),
+        ];
+        instructions.extend(ixs);
+        let mut signers = vec![&self.payer];
+        signers.extend_from_slice(extra);
+        let before = self.tok(self.vault_token) as u128;
+        self.svm.expire_blockhash();
+        let tx = Transaction::new_signed_with_payer(&instructions, Some(&self.payer.pubkey()), &signers, self.svm.latest_blockhash());
+        let r = self.svm.send_transaction(tx).map(|_| ()).map_err(|e| format!("{e:?}"));
+        let after = self.tok(self.vault_token) as u128;
+        if after > before { self.paid_in += after - before } else { self.paid_out += before - after }
+        r
+    }
+    fn limits_earn_json(&self, user: &Keypair, extra: serde_json::Value) -> serde_json::Value {
+        let mut v = serde_json::json!({
+            "programId": self.pid.to_string(), "market": self.market.to_string(), "domain": DOMAIN,
+            "user": user.pubkey().to_string(), "lpMint": self.lp_mint.to_string(), "vaultToken": self.vault_token.to_string(),
+            "vaultAuthority": self.vault_authority.to_string(), "escrow": self.escrow.to_string(),
+            "marketB64": self.limits_b64_of(&self.market), "registryB64": self.limits_b64_of(&self.registry),
+            "vaultLpStateB64": self.limits_b64_of(&self.vault_lp),
+        });
+        for (k, x) in extra.as_object().unwrap() { v[k] = x.clone(); }
+        v
+    }
+    fn limits_exit_json(&self, portfolios: &[Pubkey]) -> serde_json::Value {
+        let ps: Vec<serde_json::Value> = portfolios
+            .iter()
+            .filter(|p| self.svm.get_account(p).map(|a| !a.data.is_empty()).unwrap_or(false))
+            .map(|p| {
+                let (pid_, seq, pep) = self.identity(*p);
+                serde_json::json!({"key": p.to_string(), "dataB64": self.limits_b64_of(p), "portfolioId": pid_.to_string(), "matcherSequence": seq.to_string(), "positionEpoch": pep.to_string()})
+            })
+            .collect();
+        serde_json::json!({
+            "programId": self.pid.to_string(), "market": self.market.to_string(), "domain": DOMAIN,
+            "marketB64": self.limits_b64_of(&self.market), "registryB64": self.limits_b64_of(&self.registry),
+            "vaultLpStateB64": self.limits_b64_of(&self.vault_lp), "portfolios": ps,
+            "nowSlot": self.svm.get_sysvar::<solana_sdk::clock::Clock>().slot.to_string(),
+            "payer": self.payer.pubkey().to_string(), "mint": self.mint.to_string(),
+            "vaultToken": self.vault_token.to_string(), "vaultAuthority": self.vault_authority.to_string(),
+        })
+    }
+}
