+fn limits_app_p3_end_to_end() {
+    let mut env = Env::new(Params { fee_bps: 30, ..Params::default() });
+    env.limits_add_ata_program();
+    let admin = env.admin.insecure_clone();
+    // Earn seed (the wizard's M4a) BEFORE binding: InitVaultLp seeds C from it.
+    let seed = env.new_depositor();
+    env.earn_deposit(&seed, 10_000_000, None).expect("earn seed (unbound)");
+
+    // 1. APP wizard M4p: createAccount(vault LP) + 94 (path A, creator = marketauth) + 96.
+    let lp_kp = Keypair::new();
+    let ctx_kp = Keypair::new();
+    let junior_src = env.token_account(env.mint, admin.pubkey(), 60_000_000);
+    let rent = env.svm.minimum_balance_for_rent_exemption(env.plen);
+    let ctx_rent = env.svm.minimum_balance_for_rent_exemption(MATCHER_CONTEXT_LEN);
+    let v = limits_app("bind", serde_json::json!({
+        "programId": env.pid.to_string(), "market": env.market.to_string(), "domain": DOMAIN,
+        "creator": admin.pubkey().to_string(), "vaultLpPortfolio": lp_kp.pubkey().to_string(),
+        "portfolioLen": env.plen, "rent": rent, "floorBps": 2_000, "juniorAtoms": "60000000",
+        "matcherProgram": CANONICAL_MATCHER.to_string(), "matcherCtx": ctx_kp.pubkey().to_string(), "ctxRent": ctx_rent,
+        "creatorAta": junior_src.to_string(), "vaultToken": env.vault_token.to_string(),
+    }));
+    let bind = limits_ixs(&v);
+    assert_eq!(bind.len(), 4, "createAccount(LP) + createAccount(ctx) + 94 + 96");
+    assert_eq!(bind[2].accounts.len(), 11, "94 carries the auto-pin tail [8] matcher, [9] ctx, [10] delegate");
+    env.limits_send(bind, &[&admin, &lp_kp, &ctx_kp]).expect("APP wizard bind (ctx + 94 auto-pin + 96)");
+    assert_eq!(env.vlp().junior_deposited_atoms, 60_000_000, "junior funded by the app");
+    assert_eq!(env.vlp().junior_owner, admin.pubkey().to_bytes(), "path A: creator is the junior owner");
+    assert_eq!(env.vlp().lp_portfolio, lp_kp.pubkey().to_bytes());
+    // 2. AUTO-PIN (07a1d0eb): no protocol step. Tag 94 approved the canonical matcher and pinned
+    // the ctx; the market trades right away.
+    assert_eq!(env.asset_rec().approved_matcher_program, CANONICAL_MATCHER.to_bytes());
+    let delegate = Pubkey::find_program_address(
+        &[b"matcher", env.market.as_ref(), lp_kp.pubkey().as_ref(), env.registry.as_ref(), CANONICAL_MATCHER.as_ref(), ctx_kp.pubkey().as_ref()],
+        &env.pid,
+    ).0;
+    let lp = Lp { portfolio: lp_kp.pubkey(), owner_key: env.registry, ctx: ctx_kp.pubkey(), delegate };
+    let early = env.new_trader(20_000_000);
+    env.trade(&early, &lp, 5 * POS).expect("a trade lands immediately after the app's bind");
+    env.svm.expire_blockhash();
+    env.trade(&early, &lp, -5 * POS).expect("and closes");
+    if let Ok(path) = std::env::var("LIMITS_DUMP_VAULT_LP") {
+        let d = env.svm.get_account(&lp_kp.pubkey()).unwrap().data;
+        let j = serde_json::json!({"programId": env.pid.to_string(), "market": env.market.to_string(), "registry": env.registry.to_string(),
+            "vaultLp": lp_kp.pubkey().to_string(), "ctx": ctx_kp.pubkey().to_string(), "delegate": delegate.to_string(),
+            "matcher": CANONICAL_MATCHER.to_string(), "dataB64": limits_b64(&d), "headP3": "07a1d0eb"});
+        std::fs::write(path, j.to_string()).unwrap();
+    }
+
+    // 3. APP Earn deposit on the BOUND vault: tail [11]/[12] present.
+    let d = env.new_depositor();
+    let v = limits_app("deposit", env.limits_earn_json(&d.kp, serde_json::json!({
+        "lpAta": d.lp_ata.to_string(), "source": d.source.to_string(), "amount": "5000000"})));
+    assert_eq!(v["tail"], serde_json::json!(true), "bound registry => the app sends the tail");
+    let dep = limits_ixs(&v);
