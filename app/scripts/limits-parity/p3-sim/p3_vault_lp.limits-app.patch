+/// 07a1d0eb: fees left unharvested at resolution. The APP's sweep runs 78 once the market is
+/// terminal-flat (step "harvest"), and the APP's redemption then pays (it also prepends 78 if
+/// fees are still pending).
+#[test]
+fn limits_app_p3_resolved_harvest_then_redeem() {
+    let mut env = Env::new(Params { fee_bps: 30, ..Params::default() });
+    env.limits_add_ata_program();
+    let lp = env.bind(1_000);
