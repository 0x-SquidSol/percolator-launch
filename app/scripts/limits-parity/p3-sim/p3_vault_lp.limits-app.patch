+    env.junior_deposit_as(&admin, lp.portfolio, 60_000_000).expect("junior");
+    let t = env.new_trader(20_000_000);
+    env.trade(&t, &lp, 50 * POS).expect("open");
+    env.svm.expire_blockhash();
+    env.trade(&t, &lp, -50 * POS).expect("close");
+    env.resolve();
+    let ports = [lp.portfolio, t.portfolio];
+    let mut phases = Vec::new();
+    for round in 0..10 {
+        let v = limits_app("exit", env.limits_exit_json(&ports));
+        let phase = v["phase"].as_str().unwrap().to_string();
+        phases.push(format!("{phase}:{}", v["steps"].as_array().and_then(|s| s.first()).map(|x| x["kind"].as_str().unwrap_or("").to_string()).unwrap_or_default()));
+        if phase == "ready" { break; }
+        let ixs = limits_ixs(&v);
+        assert!(!ixs.is_empty(), "round {round}: nothing planned ({v})");
+        env.limits_send(ixs, &[]).unwrap_or_else(|e| panic!("round {round}: {e}\nplan {v}"));
+    }
+    println!("LIMITS-APP P3 resolved harvest: {phases:?}");
+    assert!(phases.iter().any(|p| p.ends_with(":harvest")), "the sweep harvested after terminal-flat: {phases:?}");
+    let shares = env.lp_shares(&d);
+    env.earn_request(&d, shares);
+    let v = limits_app("execute", env.limits_earn_json(&d.kp, serde_json::json!({
+        "redemption": d.redemption.to_string(), "dest": d.dest.to_string()})));
+    assert!(v.get("blocked").is_none(), "{v}");
+    env.limits_send(limits_ixs(&v), &[&d.kp.insecure_clone()]).expect("APP resolved redemption after the harvest");
+    println!("LIMITS-APP P3 resolved harvest: redemption paid {}", env.tok(d.dest));
+    assert!(env.tok(d.dest) > 10_000_000, "the senior got its share of the harvested fees");
+}
+
+/// E2E B12 (app side): a trader's OWN portfolio on a Resolved market is cleaned up by the APP's
+/// owner-signed groups (useCloseMarket -> lib/limits/own-portfolio-cleanup.ts): 30 then 8, with
+/// the documented fallback (group without the 8) when the 8 cannot land in the same tx.
+#[test]
+fn limits_app_p3_own_cleanup_before_reclaim() {
+    let mut env = Env::new(Params { fee_bps: 30, ..Params::default() });
+    env.limits_add_ata_program();
+    let lp = env.bind(1_000);
+    let admin = env.admin.insecure_clone();
+    env.junior_deposit_as(&admin, lp.portfolio, 60_000_000).expect("junior");
+    let t = env.new_trader(20_000_000);
+    env.trade(&t, &lp, 50 * POS).expect("open");
+    env.svm.expire_blockhash();
+    env.trade(&t, &lp, -50 * POS).expect("close");
+    env.resolve();
+    // settle the vault LP first (the sweep's rule) so the trader's close is not progress-only
+    let junior_dest = env.token_account(env.mint, admin.pubkey(), 0);
+    env.settle_resolved(&Keypair::new(), lp.portfolio, 0, junior_dest).expect("settle vault LP");
+    env.paid_out += env.tok(junior_dest) as u128; // the junior's SPL from 101 (harness books it here)
+    let mut j = env.limits_exit_json(&[t.portfolio]);
+    j["owner"] = serde_json::json!(t.kp.pubkey().to_string());
+    let v = limits_app("own-cleanup", j);
+    assert_eq!(v["kind"], serde_json::json!("close-resolved"), "{v}");
+    let with_close = limits_ixs(&serde_json::json!({"ixs": v["withClose"]}));
+    let without = limits_ixs(&serde_json::json!({"ixs": v["withoutClose"]}));
+    let tk = t.kp.insecure_clone();
+    let ata = Pubkey::find_program_address(&[t.kp.pubkey().as_ref(), spl_token::ID.as_ref(), env.mint.as_ref()], &LIMITS_ATA_PROGRAM).0;
+    let before_count = { let (_, g) = env.market_state(); g.materialized_portfolio_count };
+    let r = env.limits_send(with_close, &[&tk]);
+    let route = if r.is_ok() { "30+8" } else { env.limits_send(without, &[&tk]).expect("fallback without the 8"); "30 only" };
+    let (_, g) = env.market_state();
+    println!("LIMITS-APP B12: route {route}; materialized {before_count} -> {}; owner ATA paid {}", g.materialized_portfolio_count, env.tok(ata));
+    assert!(env.tok(ata) > 0, "the resolved payout went to the owner's ATA");
+    assert_eq!(route, "30+8", "on this path the 8 lands in the same tx");
+    assert_eq!(g.materialized_portfolio_count, before_count - 1, "the trader's portfolio is dematerialized");
+    env.assert_conserved("B12 own cleanup");
+}
