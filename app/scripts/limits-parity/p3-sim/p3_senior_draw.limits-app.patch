+#[test]
+fn limits_app_senior_draw_absorbed_logs_and_88_recall_then_redeem() {
+    let (mut w, seniors, _t) = q1_world(9_000_000, 1_000_000, 1_000_000, 6);
+    assert_eq!(outstanding(&w), 0, "vacuity: nothing booked yet (the loss is pending on the vault LP)");
+    // 0. The FIRST C-reading instruction is an APP-built Earn deposit (75, vault LP writable, 78
+    //    prepended when fees are pending): it draws/books the loss, and the app's parser reads
+    //    "Earn absorbed" from that transaction's real logs.
+    let first = Keypair::new();
+    w.env.ensure_signer_account(first.pubkey());
+    let f_ata = w.lp_share_ata(first.pubkey());
+    let f_src = w.token(first.pubkey(), 1_000);
+    let v = la_app("deposit", w.la_earn_json(&first, serde_json::json!({ "lpAta": f_ata.to_string(), "source": f_src.to_string(), "amount": "1000" })));
+    let logs0 = w.la_send(la_ixs(&v["ixs"]), &[&first]).expect("APP 75 books the pending draw");
+    let out0 = outstanding(&w);
+    assert!(out0 > 0, "vacuity: the app tx booked a senior draw");
+    let p0 = la_app("draw-logs", serde_json::json!({ "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(), "logs": logs0 }));
+    println!("LIMITS-APP DRAW: first 75 logs -> {}", p0["summary"]);
+    assert_eq!(p0["summary"]["earnAbsorbed"], serde_json::json!(out0.to_string()), "Earn absorbed, read from the app tx's logs: {p0}");
+
+    // 1. "Earn absorbed" from REAL bytes through the app decoder.
+    let ea = la_app("earn-absorbed", serde_json::json!({ "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(), "vaultLpStateB64": w.la_b64_of(&w.state_pda) }));
+    assert_eq!(ea["outstanding"], serde_json::json!(out0.to_string()), "{ea}");
+    assert_eq!(ea["drawn"], serde_json::json!(drawn(&w).to_string()), "{ea}");
+    println!("LIMITS-APP DRAW: Earn absorbed {} (drawn {})", out0, drawn(&w));
+
+    // 2. Recovery: the junior re-funds; an APP-built Earn deposit (75, vault LP writable) books
+    //    the seniors-first restore, and the app's log parser reads it from the real logs.
+    let admin = w.env.admin.insecure_clone();
+    w.junior_deposit(&admin, 2_000_000).unwrap();
+    let lp = w.lp;
+    let _ = w.crank(lp);
+    let dep = Keypair::new();
+    w.env.ensure_signer_account(dep.pubkey());
+    let lp_ata = w.lp_share_ata(dep.pubkey());
+    let src = w.token(dep.pubkey(), 1_000);
+    let v = la_app("deposit", w.la_earn_json(&dep, serde_json::json!({ "lpAta": lp_ata.to_string(), "source": src.to_string(), "amount": "1000" })));
+    let dixs = la_ixs(&v["ixs"]);
+    let d75 = dixs.last().unwrap();
+    assert!(d75.accounts[12].is_writable, "d119eebd: 75 passes the vault LP WRITABLE");
+    assert!(d75.accounts[7].is_writable && d75.accounts[10].is_writable, "both pot ledgers writable");
+    let logs = w.la_send(dixs, &[&dep]).expect("APP 75 (books the restore)");
+    let parsed = la_app("draw-logs", serde_json::json!({ "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(), "logs": logs }));
+    println!("LIMITS-APP DRAW: 75 logs -> {}", parsed["summary"]);
+    assert_eq!(parsed["summary"]["earnRestored"], serde_json::json!(out0.to_string()), "the app reads the restore from the logs: {parsed}");
+    assert_eq!(outstanding(&w), 0, "restored in full");
+    let ea2 = la_app("earn-absorbed", serde_json::json!({ "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(), "vaultLpStateB64": w.la_b64_of(&w.state_pda) }));
+    assert_eq!(ea2["outstanding"], serde_json::json!("0"));
+    assert_eq!(ea2["restored"], serde_json::json!(out0.to_string()));
+
+    // 3. B24 / 88: the senior's APP 77 is refused 88 (the pot can't fund it; value sits in the LP).
+    let (k, ata) = (&seniors[0].0.insecure_clone(), seniors[0].1);
+    let shares = w.tok(&ata) as u128;
+    let (c_before, s_before) = (w.c(), w.registry_shares());
+    let fair = c_before * shares / s_before;
+    w.request_redeem(k, ata, shares).unwrap();
+    let red = state::derive_lp_redemption(&w.env.program_id, &w.registry, &k.pubkey()).0;
+    let dest = w.token(k.pubkey(), 0);
+    let rv = la_app("recall-variants", w.la_earn_json(k, serde_json::json!({ "redemption": red.to_string(), "dest": dest.to_string() })));
+    let plain = la_ixs(&rv["plain"]);
+    let p77 = plain.last().unwrap();
+    assert!(p77.accounts[14].is_writable, "d119eebd: 77 passes the vault LP WRITABLE");
+    assert!(p77.accounts[8].is_writable && p77.accounts[11].is_writable, "both pot ledgers writable");
+    let e = w.la_send(plain, &[k]).unwrap_err();
+    assert!(e.contains("Custom(88)"), "NEGATIVE CONTROL: the plain app 77 is refused 88 VaultLpRedeemNeedsRecall: {e}");
+    // 4. The app's repair: first candidate that lands (sendTx simulates them in this order).
+    let mut paid = None;
+    for var in rv["variants"].as_array().unwrap() {
+        let r = w.la_send(la_ixs(&var["ixs"]), &[k]);
+        println!("LIMITS-APP 88: recall {} -> {:?}", var["amount"], r.as_ref().err());
+        if r.is_ok() {
+            paid = Some((var["amount"].as_str().unwrap().to_string(), w.tok(&dest)));
+            break;
+        }
+    }
+    let (amt, got) = paid.expect("the app's recall-then-redeem path lands");
+    println!("LIMITS-APP 88: recalled {amt}, senior paid {got}");
+    println!("LIMITS-APP 88: fair pro-rata claim {fair} (C {c_before}, shares {shares} / {s_before})");
+    assert!(got as u128 + 2 >= fair, "senior paid its full pro-rata claim: {got} < {fair}");
+    conserved(&w, "limits app 88");
+}
+
+/// 39b138c8 gate-100: a large live redeem through a pot whose ledger principal is too small is
+/// refused 25 (EngineCounterUnderflow) BEFORE the 88 check. The app's repair
+/// (redeemRepairVariants, the lists sendTx simulates) tries: the other pot, a recall, then the
+/// other pot + a recall into it. Seniors split across pots (1M in d0, 9M in d1), four states:
+/// draw outstanding / restored x the d0 / d1 senior. Every one ends paid its pro-rata claim.
+#[test]
+fn limits_app_redeem_repair_25_pot_mismatch_and_88() {
+    let mut seen_25 = false;
+    for scen in 0..4 {
+        let (mut w, seniors, _t) = q1_world(1_000_000, 9_000_000, 1_000_000, 6);
+        let first = Keypair::new();
+        w.env.ensure_signer_account(first.pubkey());
+        let f_ata = w.lp_share_ata(first.pubkey());
+        let f_src = w.token(first.pubkey(), 1_000);
+        let v = la_app("deposit", w.la_earn_json(&first, serde_json::json!({ "lpAta": f_ata.to_string(), "source": f_src.to_string(), "amount": "1000" })));
+        w.la_send(la_ixs(&v["ixs"]), &[&first]).expect("75 books the draw");
+        if scen >= 2 {
+            let admin = w.env.admin.insecure_clone();
+            w.junior_deposit(&admin, 2_000_000).unwrap();
+            let lp = w.lp;
+            let _ = w.crank(lp);
+            let d2 = Keypair::new();
+            w.env.ensure_signer_account(d2.pubkey());
+            let a2 = w.lp_share_ata(d2.pubkey());
+            let s2 = w.token(d2.pubkey(), 1_000);
+            let v = la_app("deposit", w.la_earn_json(&d2, serde_json::json!({ "lpAta": a2.to_string(), "source": s2.to_string(), "amount": "1000" })));
+            w.la_send(la_ixs(&v["ixs"]), &[&d2]).expect("75 books the restore");
+        }
+        let (k, ata) = (&seniors[scen % 2].0.insecure_clone(), seniors[scen % 2].1);
+        let shares = w.tok(&ata) as u128;
+        let fair = w.c() * shares / w.registry_shares();
+        w.request_redeem(k, ata, shares).unwrap();
+        let red = state::derive_lp_redemption(&w.env.program_id, &w.registry, &k.pubkey()).0;
+        let dest = w.token(k.pubkey(), 0);
+        let rv = la_app("recall-variants", w.la_earn_json(k, serde_json::json!({ "redemption": red.to_string(), "dest": dest.to_string() })));
+        let plain = w.la_send(la_ixs(&rv["plain"]), &[k]);
+        if scen == 0 {
+            plain.expect("control: the small d0 senior redeems from its own pot, no repair");
+            assert!(w.tok(&dest) as u128 + 2 >= fair);
+            continue;
+        }
+        let e = plain.unwrap_err();
+        assert!(e.contains("Custom(25)") || e.contains("Custom(88)"), "scen {scen}: plain 77 refused 25/88: {e}");
+        seen_25 |= e.contains("Custom(25)");
+        let mut landed = None;
+        for var in rv["variants"].as_array().unwrap() {
+            if w.la_send(la_ixs(&var["ixs"]), &[k]).is_ok() {
+                landed = Some(var["kind"].as_str().unwrap().to_string());
+                break;
+            }
+        }
+        let kind = landed.unwrap_or_else(|| panic!("scen {scen}: no repair variant landed"));
+        let paid = w.tok(&dest) as u128;
+        println!("LIMITS-APP REPAIR scen {scen}: plain {} -> {kind}, paid {paid} (fair {fair})", if e.contains("Custom(25)") { 25 } else { 88 });
+        assert!(paid + 2 >= fair, "scen {scen}: paid {paid} < fair {fair}");
+        conserved(&w, "redeem repair");
+    }
+    assert!(seen_25, "vacuity: the 39b138c8 25-before-88 ordering was exercised");
+}
