+        self.ledger = derive_lp_backing_ledger(&self.pid, &market, DOMAIN).0;
+        self.sibling = derive_lp_backing_ledger(&self.pid, &market, DOMAIN ^ 1).0;
+        self.vault_lp = derive_vault_lp_state(&self.pid, &market).0;
