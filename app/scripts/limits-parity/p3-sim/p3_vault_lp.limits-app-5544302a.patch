+    err_has(&env.limits_send(limits_ixs(&over), &[&admin]), PercolatorError::VaultLpReleaseRefused);
+    env.limits_send(limits_ixs(&v), &[&admin]).expect("APP junior 102 Resolved");
+    assert_eq!(env.tok(ata), amount, "junior paid physical - C to its own ATA");
+    println!("LIMITS-APP F14: junior 102 paid {amount} (needHarvest {})", v["needHarvest"]);
+    let after = limits_app("junior-release", env.limits_junior_release_json(&admin, None));
+    assert_eq!(after["amount"], serde_json::json!("0"), "nothing left for the junior: {after}");
+    assert_eq!(after["ixs"].as_array().unwrap().len(), 0, "the app plans nothing once released");
+    env.assert_conserved("limits app F-14 terminal order");
+}
+
+/// Wrapper 5544302a (class-(b) fix): on a Resolved market at terminal-flat the vault LP's
+/// claim-originated payout sits as STRAY pot backing until tag 78 runs, so a senior's 77 refuses
+/// 84 (VaultLpHarvestPending). The APP's payout (earnTxPlan from raw bytes) meets that refusal in
+/// its pre-sign simulation and rebuilds the same payout with 78 in front (sendWithHarvestOn84,
+/// bridge `execute` + `forceHarvest`), which pays. Setup = upstream's F-8 repro (the vault LP wins).
+#[test]
+fn limits_app_p3_resolved_77_after_vault_lp_win_needs_78_first() {
+    let mut env = Env::new(Params::default());
+    env.limits_add_ata_program();
+    let lp = env.bind(1_000);
+    let admin = env.admin.insecure_clone();
+    let d = env.new_depositor();
+    env.earn_deposit(&d, 10_000_000, Some(lp.portfolio)).expect("earn");
+    env.junior_deposit_as(&admin, lp.portfolio, 3_000_000).expect("junior");
+    let t = env.new_trader(5_000_000);
+    env.trade(&t, &lp, 3 * POS).expect("trader long 3 vs vault LP");
+    env.move_price(700_000, &[lp.portfolio, t.portfolio]);
+    env.resolve();
+    let junior_dest = env.token_account(env.mint, admin.pubkey(), 0);
+    env.trader_close_resolved(&t);
+    env.settle_resolved(&Keypair::new(), lp.portfolio, 0, junior_dest).expect("settle");
+    let registry = env.registry;
+    env.permissionless_close_portfolio(lp.portfolio, registry).expect("cleanup vault LP");
+    let towner = t.kp.pubkey();
+    env.permissionless_close_portfolio(t.portfolio, towner).expect("cleanup trader");
+    // No keeper 78 here: the app must cope on its own.
+    let shares = env.lp_shares(&d);
+    env.earn_request(&d, shares);
+    let extra = |force: bool| serde_json::json!({"redemption": d.redemption.to_string(), "dest": d.dest.to_string(), "forceHarvest": force});
+    let plain = limits_app("execute", env.limits_earn_json(&d.kp, extra(false)));
+    assert!(plain.get("blocked").is_none(), "{plain}");
+    let first = env.limits_send(limits_ixs(&plain), &[&d.kp.insecure_clone()]);
+    println!("LIMITS-APP 5544: plain 77 prependHarvest={} -> {:?}", plain["prependHarvest"], first.as_ref().err().map(|e| e.chars().take(120).collect::<String>()));
+    if plain["prependHarvest"] == serde_json::json!(false) {
+        // The stray is not decodable by the app: the plain payout is refused 84, exactly.
+        let e = first.expect_err("5544302a: a Resolved 77 with stray backing refuses 84 until 78");
+        assert!(e.contains(&code(PercolatorError::VaultLpHarvestPending)), "{e}");
+        // The app's pre-sign retry: the same payout with 78 in front.
+        let forced = limits_app("execute", env.limits_earn_json(&d.kp, extra(true)));
+        assert_eq!(forced["prependHarvest"], serde_json::json!(true));
+        env.limits_send(limits_ixs(&forced), &[&d.kp.insecure_clone()]).expect("APP 78 + 77 after the 84");
+    } else {
+        first.expect("the app already prepended 78");
+    }
+    let paid = env.tok(d.dest);
+    println!("LIMITS-APP 5544: senior paid {paid}");
+    assert_eq!(paid as u128, 10_000_000 * shares / (shares + 1_000), "senior redeems its full claim (less dead shares)");
+}
+
+// ── P3 ordering (5544302a / 5e4c15ff). A resolved close while another claim is still unreceipted
+// (the vault LP's before its 101, or another trader's) pays a PARTIAL receipt; the rest arrives via
+// the permissionless tag 46. A vault LP that WON can only settle once every trader leg detached.
+// The APP's Finish-now list (lib/limits/resolved-finish.ts blocks A-G) with its pre-sign pruning
+// (pruneRefusedItems) and skip rule must finish every such market with nobody underpaid.
+
+impl Env {
+    /// Owner-signed CloseResolved paying the owner's ATA; Err instead of panic.
+    fn limits_try_owner_close_resolved(&mut self, t: &Trader) -> Result<(), String> {
+        let ata = canonical_vault_ata(&t.kp.pubkey(), &self.mint);
+        if self.svm.get_account(&ata).map(|a| a.data.is_empty()).unwrap_or(true) {
+            self.svm
+                .set_account(ata, Account { lamports: 1_000_000_000, data: make_token_data(self.mint, t.kp.pubkey(), 0), owner: spl_token::ID, executable: false, rent_epoch: 0 })
+                .unwrap();
+        }
+        self.svm.expire_blockhash();
+        let kp = t.kp.insecure_clone();
+        self.send(
+            ProgInstruction::CloseResolved { fee_rate_per_slot: 0 },
+            vec![
+                AccountMeta::new(t.kp.pubkey(), true),
+                AccountMeta::new(self.market, false),
+                AccountMeta::new(t.portfolio, false),
+                AccountMeta::new(ata, false),
+                AccountMeta::new(self.vault_token, false),
+                AccountMeta::new_readonly(self.vault_authority, false),
+                AccountMeta::new_readonly(spl_token::ID, false),
+                AccountMeta::new_readonly(Pubkey::find_program_address(&[b"nft_registry", self.market.as_ref()], &self.pid).0, false),
+            ],
+            &[&kp],
+        )
+    }
+
+    fn limits_finish_tx(&self, it: &serde_json::Value, i: usize, redeemer: &Keypair) -> Transaction {
+        let cu = if std::env::var("LIMITS_FINISH_MEASURE").is_ok() { 1_400_000 } else { it["cu"].as_u64().unwrap() as u32 };
+        let mut ixs = vec![
+            ComputeBudgetInstruction::request_heap_frame(128 * 1024),
+            ComputeBudgetInstruction::set_compute_unit_limit(cu),
+            ComputeBudgetInstruction::set_compute_unit_price(1_000 + i as u64 + 1),
+        ];
+        ixs.extend(limits_ixs(it));
+        let mut signers = vec![&self.payer];
+        if it["item"]["step"]["kind"] == "earn-request" { signers.push(redeemer); }
+        Transaction::new_signed_with_payer(&ixs, Some(&self.payer.pubkey()), &signers, self.svm.latest_blockhash())
+    }
+
+    /// useResolvedExit.finish end to end: build the list (bridge `finish`), pre-sign simulate the first
+    /// needed item of each step and prune (bridge `finish-prune`), then broadcast in order with the
+    /// skip rule (bridge `finish-needed`); a refused broadcast is counted and the run continues
+    /// (runFinish). `drop`: an item kind removed (negative controls).
+    fn limits_finish_drive(&mut self, ports: &[Pubkey], args: serde_json::Value, redeemer: &Keypair, drop: Option<&str>) -> (Vec<String>, Vec<String>, usize) {
+        let v = limits_app("finish", args);
+        // `drop`: an item kind, or "retry101" = the 101 retry block (copies >= 10).
+        let dropped = |it: &serde_json::Value| match drop {
+            None => false,
+            Some("retry101") => it["item"]["step"]["kind"] == "settle-vault-lp" && it["item"]["copy"].as_u64().unwrap() >= 10,
+            Some(d) => it["item"]["step"]["kind"] == d,
+        };
+        let items: Vec<serde_json::Value> = v["items"].as_array().expect("items").iter().filter(|it| !dropped(it)).cloned().collect();
+        let label = |it: &serde_json::Value| {
+            let k = it["item"]["step"]["kind"].as_str().unwrap().to_string();
+            let who = it["item"]["step"]["portfolio"].as_str().map(|p| format!(":{}", &p[..4])).unwrap_or_default();
+            format!("{k}{who}#{}", it["item"]["copy"])
+        };
+        // Pre-sign pass.
+        let mut refused = Vec::new();
+        let mut tried = std::collections::HashSet::new();
+        for (i, it) in items.iter().enumerate() {
+            if it["item"]["step"]["kind"] == "earn-request" { continue; }
+            let mut q = self.limits_exit_json(ports);
+            q["item"] = it["item"].clone();
+            if !limits_app("finish-needed", q)["needed"].as_bool().unwrap() { continue; }
+            if !tried.insert(it["item"]["step"].to_string()) { continue; }
+            self.svm.expire_blockhash();
+            let tx = self.limits_finish_tx(it, i, redeemer);
+            if self.svm.simulate_transaction(tx.into()).is_err() { refused.push(i); }
+        }
+        let mut pq = self.limits_exit_json(ports);
+        pq["items"] = serde_json::json!(items.iter().map(|it| it["item"].clone()).collect::<Vec<_>>());
+        pq["refused"] = serde_json::json!(refused);
+        let kept = limits_app("finish-prune", pq);
+        let kept: Vec<usize> = kept["kept"].as_array().unwrap().iter().map(|x| x.as_u64().unwrap() as usize).collect();
+        let items: Vec<serde_json::Value> = kept.iter().map(|&i| items[i].clone()).take(24).collect();
+        // Broadcast with the skip rule.
+        let (mut sent, mut failed, mut skipped) = (Vec::new(), Vec::new(), 0usize);
+        for (i, it) in items.iter().enumerate() {
+            let mut q = self.limits_exit_json(ports);
+            q["item"] = it["item"].clone();
+            if !limits_app("finish-needed", q)["needed"].as_bool().unwrap() { skipped += 1; continue; }
+            self.svm.expire_blockhash();
+            let before = self.tok(self.vault_token) as u128;
+            let tx = self.limits_finish_tx(it, i, redeemer);
+            let r = self.svm.send_transaction(tx);
+            let after = self.tok(self.vault_token) as u128;
+            if after > before { self.paid_in += after - before } else { self.paid_out += before - after }
+            match r {
+                Ok(m) => {
+                    println!("LIMITS-APP partial CU: {} consumed {} (app budget {})", label(it), m.compute_units_consumed, it["cu"]);
+                    sent.push(label(it));
+                }
+                Err(e) => {
+                    println!("LIMITS-APP partial REFUSED: {} {:?}", label(it), e.err);
+                    failed.push(label(it));
+                }
+            }
+        }
+        (sent, failed, skipped)
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum PartialCase {
+    /// One trader long vs the vault LP, price up: the trader won.
+    TraderWon,
+    /// One trader long vs the vault LP, price down: the vault LP won.
+    VaultWon,
+    /// A long 10 (won) + B short 30 (lost) vs the vault LP, price up: the vault LP net won, so A's
+    /// early close is diluted by the vault LP's unreceipted claim.
+    TwoTraders,
+}
+
+struct PartialRun {
+    receipt_open_after_early_close: bool,
+    viewer_total: u64,
+    others_total: u64,
+    senior: u64,
+    sent: Vec<String>,
+    failed: Vec<String>,
+    final_phase: String,
+}
+
+fn tok0(env: &Env, k: Pubkey) -> u64 {
+    env.svm.get_account(&k).filter(|a| !a.data.is_empty()).map_or(0, |a| TokenAccount::unpack(&a.data).unwrap().amount)
+}
+
+/// `early_close`: the viewer's own CloseResolved runs right after resolve, BEFORE any 101.
+fn limits_partial_run(case: PartialCase, early_close: bool, drop: Option<&str>) -> PartialRun {
+    let mut env = Env::new(Params { fee_bps: 30, ..Params::default() });
+    env.limits_add_ata_program();
+    let lp = env.bind(1_000);
+    let admin = env.admin.insecure_clone();
+    let d = env.new_depositor();
+    env.earn_deposit(&d, 10_000_000, Some(lp.portfolio)).expect("earn");
+    env.junior_deposit_as(&admin, lp.portfolio, 60_000_000).expect("junior");
+    let viewer = env.new_trader(20_000_000);
+    let mut others: Vec<Trader> = Vec::new();
+    match case {
+        PartialCase::TraderWon | PartialCase::VaultWon => {
+            env.trade(&viewer, &lp, 20 * POS).expect("open long vs the vault LP");
+        }
+        PartialCase::TwoTraders => {
+            env.trade(&viewer, &lp, 10 * POS).expect("A long");
+            let b = env.new_trader(20_000_000);
+            env.svm.expire_blockhash();
+            env.trade(&b, &lp, -30 * POS).expect("B short");
+            others.push(b);
+        }
+    }
+    let mut crank = vec![lp.portfolio, viewer.portfolio];
+    crank.extend(others.iter().map(|t| t.portfolio));
+    env.move_price(if matches!(case, PartialCase::VaultWon) { 950_000 } else { 1_100_000 }, &crank);
+    env.resolve();
+    let vata = canonical_vault_ata(&viewer.kp.pubkey(), &env.mint);
+    let mut receipt_open = false;
+    if early_close {
+        // TwoTraders: the loser B closes first (pays in), so the viewer's winning close pays out at
+        // a rate diluted by the vault LP's still-unreceipted claim.
+        for o in &others {
+            let r = env.limits_try_owner_close_resolved(o);
+            let ob = tok0(&env, canonical_vault_ata(&o.kp.pubkey(), &env.mint));
+            println!("LIMITS-APP partial({case:?}): other's early close {r:?}; paid {ob}");
+            if r.is_ok() { env.paid_out += ob as u128; }
+        }
+        if !others.is_empty() {
+            // ... and a keeper's 101 close step runs (progress: the vault LP's claim is still unreceipted).
+            let stranger = Keypair::new();
+            let jd = env.token_account(env.mint, admin.pubkey(), 0);
+            let r = env.settle_resolved(&stranger, lp.portfolio, 0, jd);
+            println!("LIMITS-APP partial({case:?}): keeper 101(0) before the viewer's close {r:?}; junior {}", tok0(&env, jd));
+            env.paid_out += tok0(&env, jd) as u128;
+        }
+        let r = env.limits_try_owner_close_resolved(&viewer);
+        let p = env.portfolio(viewer.portfolio);
+        receipt_open = p.resolved_payout_receipt.present && !p.resolved_payout_receipt.finalized;
+        println!(
+            "LIMITS-APP partial({case:?}): early close {r:?}; receipt present {} finalized {} paid_effective {} face {}; paid {}",
+            p.resolved_payout_receipt.present, p.resolved_payout_receipt.finalized, p.resolved_payout_receipt.paid_effective,
+            p.resolved_payout_receipt.terminal_positive_claim_face, tok0(&env, vata)
+        );
+        if r.is_ok() { env.paid_out += tok0(&env, vata) as u128; }
+    }
+    let ports = crank.clone();
+    let shares = env.lp_shares(&d);
+    let mut args = env.limits_exit_json(&ports);
+    args["redeemer"] = serde_json::json!(d.kp.pubkey().to_string());
+    args["redeemerLpAta"] = serde_json::json!(d.lp_ata.to_string());
+    args["shares"] = serde_json::json!(shares.to_string());
+    args["viewer"] = serde_json::json!(viewer.kp.pubkey().to_string());
+    let (sent, failed, skipped) = env.limits_finish_drive(&ports, args, &d.kp.insecure_clone(), drop);
+    println!("LIMITS-APP partial({case:?}, early={early_close}, drop={drop:?}): sent {sent:?} failed {failed:?} skipped {skipped}");
+    let fin = limits_app("plan", env.limits_exit_json(&ports));
+    let final_phase = fin["phase"].as_str().unwrap_or("").to_string();
+    let viewer_total = tok0(&env, vata);
+    let others_total = others.iter().map(|t| tok0(&env, canonical_vault_ata(&t.kp.pubkey(), &env.mint))).sum();
+    let mut senior = 0;
+    if final_phase == "ready" {
+        let v = limits_app("execute", env.limits_earn_json(&d.kp, serde_json::json!({"redemption": d.redemption.to_string(), "dest": d.dest.to_string()})));
+        assert!(v.get("blocked").is_none(), "{v}");
+        env.limits_send(limits_ixs(&v), &[&d.kp.insecure_clone()]).expect("APP 77 after Finish now");
+        senior = env.tok(d.dest);
+        env.assert_conserved("limits partial receipt");
+    }
+    PartialRun { receipt_open_after_early_close: receipt_open, viewer_total, others_total, senior, sent, failed, final_phase }
+}
+
+fn first(sent: &[String], p: &str) -> Option<usize> { sent.iter().position(|s| s.starts_with(p)) }
+fn last(sent: &[String], p: &str) -> Option<usize> { sent.iter().rposition(|s| s.starts_with(p)) }
+
+#[test]
+fn limits_app_p3_partial_receipt_topup_after_101() {
+    let mut saw_partial = false;
+    for case in [PartialCase::TraderWon, PartialCase::VaultWon, PartialCase::TwoTraders] {
+        let base = limits_partial_run(case, false, None);
+        let early = limits_partial_run(case, true, None);
+        println!("LIMITS-APP partial({case:?}): base viewer {} others {} senior {} | early viewer {} others {} senior {} receipt_open {}",
+            base.viewer_total, base.others_total, base.senior, early.viewer_total, early.others_total, early.senior, early.receipt_open_after_early_close);
+        assert_eq!(base.final_phase, "ready", "{case:?}: one Finish now reaches terminal-flat: {:?} / {:?}", base.sent, base.failed);
+        assert_eq!(early.final_phase, "ready", "{case:?}: ... also after an early close: {:?} / {:?}", early.sent, early.failed);
+        assert_eq!(early.viewer_total, base.viewer_total, "{case:?}: no money lost to the ordering");
+        assert_eq!(early.others_total, base.others_total, "{case:?}: nobody else's payout moves");
+        assert_eq!(early.senior, base.senior, "{case:?}: the senior is paid the same");
+        assert!(base.failed.is_empty() && early.failed.is_empty(), "{case:?}: nothing refused at broadcast: {:?} {:?}", base.failed, early.failed);
+        if early.receipt_open_after_early_close {
+            saw_partial = true;
+            let t46 = first(&early.sent, "claim-topup").expect("the viewer's 46 ran");
+            assert!(t46 > last(&early.sent, "settle-vault-lp").expect("101 ran"), "{case:?}: 46 after 101 is final: {:?}", early.sent);
+            assert!(t46 < first(&early.sent, "earn-request").expect("76 ran"), "{case:?}: 46 before the viewer's 76: {:?}", early.sent);
+        }
+    }
+    // These single-step scenarios do not dilute a receipt on 5544302a (an early winner's close is
+    // progress-only; the diluted case is the gate's fuzz repro, p3_resolved_lock eedb). Reported, not
+    // asserted: the app-side ordering for an open receipt is covered by the app's model tests.
+    println!("LIMITS-APP partial: a diluted receipt was produced here: {saw_partial}");
+}
+
+/// NEGATIVE CONTROL: a vault LP that WON can only settle once every trader leg has detached. The
+/// app's list without its 101 retry block (block D, the pre-fix ordering that held traders until
+/// the vault LP settled) never finishes the market: every 101 is progress-only.
+#[test]
+fn limits_app_p3_vault_won_negative_control_without_101_retry() {
+    let r = limits_partial_run(PartialCase::VaultWon, false, Some("retry101"));
+    assert_ne!(r.final_phase, "ready", "without the 101 retry the market stays open: {:?}", r.sent);
+    assert_eq!(r.senior, 0, "and the senior's 77 never becomes payable");
+}
