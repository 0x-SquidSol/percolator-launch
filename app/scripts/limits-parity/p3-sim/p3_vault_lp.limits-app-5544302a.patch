+/// Create a market with the APP's M1 (createAccount(slab) + InitMarket), finish the harness
+/// setup (auth mark + CreateLpVault + Earn seed), then run the APP's M4p bind.
+fn limits_app_market_then_bind(p3: bool) -> (Env, Result<(), String>, Option<Lp>) {
+    let mut env = Env::new(Params { fee_bps: 30, ..Params::default() });
+    env.limits_add_ata_program();
+    let admin = env.admin.insecure_clone();
+    let slab = Keypair::new();
+    let v = limits_app("init-market", serde_json::json!({
+        "programId": env.pid.to_string(), "market": slab.pubkey().to_string(), "domain": DOMAIN, "p3": p3,
+        "initialPriceE6": PRICE.to_string(), "tradingFeeBps": 30, "initialMarginBps": 1_000, "lpCollateral": "60000000",
+        "funder": env.payer.pubkey().to_string(), "lamports": 1_000_000_000u64,
+        "admin": admin.pubkey().to_string(), "mint": env.mint.to_string(),
+    }));
+    let slots: usize = if p3 { 1 } else { 14 };
+    assert_eq!(v["maxPortfolioAssets"].as_u64().unwrap() as usize, slots, "app slot count");
+    assert_eq!(
+        v["space"].as_u64().unwrap() as usize,
+        state::market_account_len_for_capacity(slots).unwrap(),
+        "the app's slab size == the program's length for the app's slot count"
+    );
+    env.limits_send(limits_ixs(&v), &[&admin, &slab]).expect("APP createAccount(slab) + InitMarket");
+    let d = env.svm.get_account(&slab.pubkey()).unwrap().data;
+    assert_eq!(state::market_slot_capacity(&d).unwrap(), slots, "on-chain slot capacity");
+    env.limits_retarget(slab.pubkey());
+    let seq = env.oracle_seq() + 1;
+    env.send(
+        ProgInstruction::ConfigureAuthMark { market_id: 1, asset_index: 0, now_slot: 1, initial_mark_e6: PRICE, observation_sequence: seq },
+        vec![AccountMeta::new(admin.pubkey(), true), AccountMeta::new(env.market, false)],
+        &[&admin],
+    )
+    .expect("configure auth mark");
+    let (market, registry, lp_mint) = (env.market, env.registry, env.lp_mint);
+    env.send(
+        ProgInstruction::CreateLpVault { fee_share_bps: 5_000, redemption_cooldown_slots: 0, oi_reservation_threshold_bps: 0, domain: DOMAIN },
+        vec![
+            AccountMeta::new(admin.pubkey(), true),
+            AccountMeta::new(market, false),
+            AccountMeta::new(registry, false),
+            AccountMeta::new(lp_mint, false),
+            AccountMeta::new_readonly(solana_sdk::system_program::ID, false),
+            AccountMeta::new_readonly(spl_token::ID, false),
+        ],
+        &[&admin],
+    )
+    .expect("create lp vault");
+    let seed = env.new_depositor();
+    env.earn_deposit(&seed, 10_000_000, None).expect("earn seed (unbound)");
+
+    let lp_kp = Keypair::new();
+    let ctx_kp = Keypair::new();
+    let junior_src = env.token_account(env.mint, admin.pubkey(), 60_000_000);
+    let rent = env.svm.minimum_balance_for_rent_exemption(env.plen);
+    let ctx_rent = env.svm.minimum_balance_for_rent_exemption(MATCHER_CONTEXT_LEN);
+    let b = limits_app("bind", serde_json::json!({
+        "programId": env.pid.to_string(), "market": env.market.to_string(), "domain": DOMAIN,
+        "creator": admin.pubkey().to_string(), "vaultLpPortfolio": lp_kp.pubkey().to_string(),
+        "portfolioLen": env.plen, "rent": rent, "floorBps": 2_000, "juniorAtoms": "60000000",
+        "matcherProgram": CANONICAL_MATCHER.to_string(), "matcherCtx": ctx_kp.pubkey().to_string(), "ctxRent": ctx_rent,
+        "creatorAta": junior_src.to_string(), "vaultToken": env.vault_token.to_string(),
+    }));
+    let r = env.limits_send(limits_ixs(&b), &[&admin, &lp_kp, &ctx_kp]);
+    let lp = r.is_ok().then(|| {
+        let delegate = Pubkey::find_program_address(
+            &[b"matcher", env.market.as_ref(), lp_kp.pubkey().as_ref(), env.registry.as_ref(), CANONICAL_MATCHER.as_ref(), ctx_kp.pubkey().as_ref()],
+            &env.pid,
+        )
+        .0;
+        Lp { portfolio: lp_kp.pubkey(), owner_key: env.registry, ctx: ctx_kp.pubkey(), delegate }
+    });
+    (env, r, lp)
+}
