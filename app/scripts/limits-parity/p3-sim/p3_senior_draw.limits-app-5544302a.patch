+/// UX WP-2 (SH-2): the keeper stops CRANKING (prices still pushed): the engine clock lags. The
+/// APP's catch-up (bridge `catch-up` = lib/self-heal planCatchUp +
+/// buildCatchUpCrankIx) prepends k cranks of the vault LP and the SAME trade then lands in one
+/// tx. Also measures one crank's CU (recorded as CATCH_UP_CRANK_CU) and the beyond-cap case.
+#[test]
+fn limits_app_catch_up_cranks_then_trade() {
+    let (mut w, _seniors, _t) = q1_world(9_000_000, 1_000_000, 1_000_000, 0);
+    let lp = w.lp;
+    let (t2, tp2) = w.trader(20_000_000);
+    for _ in 0..5_000 {
+        if w.env.market_state().1.assets[0].slot_last >= w.slot() { break; }
+        w.env.svm.expire_blockhash();
+        let _ = w.crank(lp);
+    }
+    assert!(w.env.market_state().1.assets[0].slot_last >= w.slot(), "vacuity: the clock starts current");
+    // keeper keeps PUSHING prices but stops cranking (this world: max_accrual_dt_slots = 1,
+    // so a 5-slot lag needs ~6 cranks, inside the 1.2M CU budget)
+    let start = w.slot();
+    w.env.svm.warp_to_slot(start + 5);
+    w.push(MARK.with(|c| c.get()));
+    let trade_ix = |w: &P3| {
+        let (aid, _, aep) = w.env.portfolio_identity(tp2);
+        let (bid, bseq, bep) = w.env.portfolio_identity(w.lp);
+        Instruction {
+            program_id: w.env.program_id,
+            accounts: vec![
+                AccountMeta::new(t2.pubkey(), true),
+                AccountMeta::new(w.env.market, false),
+                AccountMeta::new(tp2, false),
+                AccountMeta::new(w.lp, false),
+                AccountMeta::new_readonly(w.matcher, false),
+                AccountMeta::new(w.ctx, false),
+                AccountMeta::new_readonly(w.delegate, false),
+            ],
+            data: ProgInstruction::TradeCpi {
+                account_a_portfolio_id: aid, account_a_position_epoch: aep,
+                account_b_portfolio_id: bid, account_b_position_epoch: bep,
+                market_id: 1, account_b_matcher_sequence: bseq, asset_index: 0,
+                size_q: U / 10, fee_bps: 0, limit_price: 0, backing_fee_cap_bps: 10_000,
+            }.encode(),
+        }
+    };
+    // On 4b1a5d30 a trade catches the engine up itself (probe `limits_probe_lag`: lags to 20,000
+    // slots with price moves all trade), so the catch-up is a repair for the refusals that remain
+    // (planSelfHeal only prepends it after a SIMULATED 19/21). Here: the app's cranks are valid
+    // on a lagging clock and land together with the trade in one tx.
+    let read_slot = w.slot();
+    let v = la_app("catch-up", serde_json::json!({
+        "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(),
+        "marketB64": w.la_b64_of(&w.env.market), "readSlot": read_slot.to_string(), "userCu": 200_000,
+        "cranker": w.env.payer.pubkey().to_string(), "portfolio": lp.to_string(),
+    }));
+    let k = v["k"].as_u64().unwrap() as usize;
+    println!("LIMITS-APP CATCHUP: lag {} dt {} -> k {k} | real slot_last {} now {} header {}", v["lagSlots"], v["dtSlots"], w.env.market_state().1.assets[0].slot_last, read_slot, 0);
+    assert!(k >= 1 && !v["beyondCap"].as_bool().unwrap());
+    // one crank's CU on these bytes
+    let crank_only = la_ixs(&v["ixs"]).into_iter().take(1).collect::<Vec<_>>();
+    let payer = w.env.payer.insecure_clone();
+    let mut probe = vec![heap_ix(), cu_ix()];
+    probe.extend(crank_only);
+    let tx = solana_sdk::transaction::Transaction::new_signed_with_payer(&probe, Some(&payer.pubkey()), &[&payer], w.env.svm.latest_blockhash());
+    let cu = w.env.svm.simulate_transaction(solana_sdk::transaction::VersionedTransaction::from(tx)).map(|m| m.compute_units_consumed).unwrap_or(0);
+    println!("LIMITS-APP CATCHUP: one crank = {cu} CU");
+    // The app's CATCH_UP_CRANK_CU (lib/self-heal.ts) must cover one crank: 17,010 on 4b1a5d30,
+    // 20,846 on ede691b6 -> budget 25,000.
+    assert!(cu > 0 && cu <= 25_000, "CATCH_UP_CRANK_CU (25,000) covers one crank: {cu}");
+    // the app's healed tx: [cranks x k, the same trade] lands in ONE transaction
+    let mut healed = la_ixs(&v["ixs"]);
+    healed.push(trade_ix(&w));
+    w.la_send(healed, &[&t2]).expect("catch-up cranks + trade land in one tx");
+    assert!(w.env.market_state().1.assets[0].slot_last >= read_slot, "engine clock caught up");
+    // beyond the cap: a 5,000-slot lag needs 250 cranks -> not attempted (keeper catches up; SH-3)
+    let s2 = w.slot();
+    w.env.svm.warp_to_slot(s2 + 5_000);
+    w.push(MARK.with(|c| c.get()));
+    let v2 = la_app("catch-up", serde_json::json!({
+        "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(),
+        "marketB64": w.la_b64_of(&w.env.market), "readSlot": w.slot().to_string(), "userCu": 200_000,
+        "cranker": w.env.payer.pubkey().to_string(), "portfolio": lp.to_string(),
+    }));
+    assert_eq!(v2["k"], serde_json::json!(0));
+    assert_eq!(v2["beyondCap"], serde_json::json!(true));
+}
