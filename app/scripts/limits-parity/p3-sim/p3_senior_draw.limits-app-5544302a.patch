+impl P3 {
+    /// The app's Earn preview (earn-price bridge: lib/limits/earn.ts earnPanelPricing) from RAW
+    /// bytes, with the NAV the page gives it (useInsuranceLP vaultTotalAtoms = registry shares +
+    /// fee_distribution_total_atoms).
+    fn la_price(&self, shares: u128) -> serde_json::Value {
+        let reg = self.env.svm.get_account(&self.registry).and_then(|a| state::read_lp_vault_registry(&a.data).ok()).expect("registry");
+        let backing = reg.total_lp_shares_outstanding + reg.fee_distribution_total_atoms;
+        la_app("earn-price", serde_json::json!({
+            "programId": self.env.program_id.to_string(), "market": self.env.market.to_string(),
+            "marketB64": self.la_b64_of(&self.env.market), "lpB64": self.la_b64_of(&self.lp),
+            "vaultLpStateB64": self.la_b64_of(&self.state_pda), "registryB64": self.la_b64_of(&self.registry),
+            "backing": backing.to_string(), "shares": shares.to_string(),
+        }))
+    }
+    fn la_redeem(&mut self, k: &Keypair) -> Result<u64, String> {
+        let red = state::derive_lp_redemption(&self.env.program_id, &self.registry, &k.pubkey()).0;
+        let dest = self.token(k.pubkey(), 0);
+        let v = la_app("execute", self.la_earn_json(k, serde_json::json!({ "redemption": red.to_string(), "dest": dest.to_string() })));
+        assert!(v["blocked"].is_null(), "app 77 planned: {v}");
+        self.la_send(la_ixs(&v["ixs"]), &[k])?;
+        Ok(self.tok(&dest))
+    }
+}
