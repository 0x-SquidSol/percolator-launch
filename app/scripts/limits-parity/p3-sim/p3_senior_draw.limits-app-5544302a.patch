+/// ede691b6 (Earn exit priced at the WORSE of effective vs pending target): the app's preview —
+/// earnPanelPricing -> earnSeniorPricing, the one port of `vault_lp_equity_lag_bounds_ro` + the 77
+/// Live rule — equals the program's 77 payout to the atom, with and without a pending move.
+/// Control (no move): preview == payout == the plain pre-ede691b6 number. Move (3x target, eff
+/// lagging at 20 bps / slot): the bounds are evaluated from real bytes (worse < better); the
+/// program keeps the bound LP's exposure within its equity at the target, so the move stays inside
+/// the junior and the preview equals the payout exactly (the binding branches — C_price below C and
+/// the LP valued at max(worse, 0) when nav < C — are pinned by earn-pricing.test.ts).
+#[test]
+fn limits_app_worse_of_77_payout_matches_preview() {
+    // The lagging-price market (max 20 bps / slot, 5x): the effective price trails a pushed mark.
+    TL_IM.with(|c| c.set(2_000));
+    let s1 = Keypair::new();
+    let s2 = Keypair::new();
+    let (mut w, atas) = P3::bound(&[(&s1, 5_000_000), (&s2, 5_000_000)], 300_000, 1_000);
+    // The vault LP may run 5x its equity (99 SetVaultLpRisk), so a move can exceed the junior.
+    let up = w.upgrade.insecure_clone();
+    w.set_risk(&up, 50_000).expect("99 vault LP 5x");
+    let (t, tp) = w.trader(50_000_000);
+    w.trade_vs_lp(&t, tp, 14 * U / 10).expect("trader long 1.4 vs the vault LP (LP short 1.4)");
+    crank_lp_until_current(&mut w);
+    let sh1 = w.tok(&atas[0]) as u128;
+    let sh2 = w.tok(&atas[1]) as u128;
+    w.request_redeem(&s1, atas[0], sh1).expect("76 s1");
+    w.request_redeem(&s2, atas[1], sh2).expect("76 s2");
+
+    // CONTROL: no pending move.
+    let p1 = w.la_price(sh1);
+    println!("LIMITS-APP WORSE-OF control: {p1}");
+    assert_eq!(p1["eff"], p1["tgt"], "vacuity: no catch-up in the control");
+    assert_eq!(p1["withdrawAtoms"], p1["plainWithdrawAtoms"], "no move => the plain number");
+    let paid1 = w.la_redeem(&s1).expect("app 77 s1 (control)");
+    println!("LIMITS-APP WORSE-OF control: preview {} paid {paid1}", p1["withdrawAtoms"]);
+    assert_eq!(p1["withdrawAtoms"], serde_json::json!(paid1.to_string()), "control: preview == payout");
+
+    // The keeper publishes 3x (the vault LP's short is ~0.27 after the exposure clamp, equity ~0.3):
+    // the effective price lags (max 20 bps / slot), so the move is pending, not realised, and at
+    // the target it exceeds the junior.
+    println!("LIMITS-APP WORSE-OF before push: lp pos {} trader pos {}", w.pos(w.lp), w.pos(tp));
+    w.push(PRICE * 3);
+    println!("LIMITS-APP WORSE-OF after push: lp pos {} trader pos {}", w.pos(w.lp), w.pos(tp));
+    let lp_ = w.lp;
+    let r = w.crank(lp_);
+    println!("LIMITS-APP WORSE-OF one crank: {:?} lp pos {} trader pos {} eff {}", r.as_ref().map_err(|e| code(e)), w.pos(w.lp), w.pos(tp), w.env.market_state().1.assets[0].effective_price);
+    crank_lp_until_current(&mut w);
+    println!("LIMITS-APP WORSE-OF after cranks: lp pos {} trader pos {}", w.pos(w.lp), w.pos(tp));
+    let p2 = w.la_price(sh2);
+    println!("LIMITS-APP WORSE-OF move: {p2}");
+    let lpst = w.lp_state();
+    for l in lpst.legs.iter().filter(|l| l.active) { println!("LIMITS-APP WORSE-OF rust leg: asset {} side {:?} basis {}", l.asset_index, l.side, l.basis_pos_q); }
+    let (eff, tgt): (u128, u128) = (p2["eff"].as_str().unwrap().parse().unwrap(), p2["tgt"].as_str().unwrap().parse().unwrap());
+    assert!(tgt > eff, "vacuity: the effective price lags the target ({eff} vs {tgt})");
+    let (pre, plain): (u128, u128) = (p2["withdrawAtoms"].as_str().unwrap().parse().unwrap(), p2["plainWithdrawAtoms"].as_str().unwrap().parse().unwrap());
+    let (worse, better): (i128, i128) = (p2["worse"].as_str().unwrap().parse().unwrap(), p2["better"].as_str().unwrap().parse().unwrap());
+    assert!(worse < better, "the lag bounds are evaluated on a pending move: worse {worse} < better {better}");
+    // On this build the crank re-stamps the bound vault LP's leg so its exposure fits its equity AT
+    // THE TARGET (short 1.4 -> ~0.14 here), so a pending move stays inside the junior (worse >= 0):
+    // "a move the junior absorbs changes nothing for seniors" — the preview must say exactly that.
+    assert!(worse >= 0, "reachable state: the junior absorbs the pending move (worse {worse})");
+    assert_eq!(pre, plain, "junior-absorbed move: the exit price is unchanged");
+    let paid2 = w.la_redeem(&s2).expect("app 77 s2 (move pending)") as u128;
+    println!("LIMITS-APP WORSE-OF move: preview {pre} paid {paid2} plain {plain} (worse {})", p2["worse"]);
+    assert_eq!(pre, paid2, "preview == the program's payout, to the atom");
+    conserved(&w, "worse-of 77");
+}
+
+impl P3 {
+    /// UX WP-6 bridge: the app's first-trade txs (lib/first-trade.ts) for `owner` / `portfolio`.
+    fn la_first_trade(&mut self, owner: &Keypair, portfolio: &Keypair, src: Pubkey, size: i128, real: bool) -> serde_json::Value {
+        let rent = self.env.svm.minimum_balance_for_rent_exemption(state::portfolio_account_len_for_market_slots(1).unwrap().max(9_600));
+        let mut j = serde_json::json!({
+            "programId": self.env.program_id.to_string(), "market": self.env.market.to_string(),
+            "owner": owner.pubkey().to_string(), "portfolio": portfolio.pubkey().to_string(),
+            "userAta": src.to_string(), "vaultToken": self.env.vault.to_string(), "depositAtoms": "1000000",
+            "lp": self.lp.to_string(), "matcherProg": self.matcher.to_string(), "matcherCtx": self.ctx.to_string(),
+            "matcherDelegate": self.delegate.to_string(), "lpB64": self.la_b64_of(&self.lp),
+            "marketB64": self.la_b64_of(&self.env.market), "size": size.to_string(), "limitPriceE6": (PRICE * 2).to_string(),
+            "rent": rent,
+        });
+        if real {
+            j["portfolioB64"] = serde_json::json!(self.la_b64_of(&portfolio.pubkey()));
+        }
+        la_app("first-trade", j)
+    }
+}
+
+/// UX WP-6 (audit §3.2): the first trade in ONE signature. The app builds tx A [CreateAccount,
+/// InitPortfolio] and tx B [Deposit, TradeCpi] BEFORE A lands (both signed together), B bound to
+/// the PREDICTED portfolio id read from the market bytes (asset 0 AssetOracleProfileV16
+/// .next_portfolio_id @480, what handle_init_portfolio allocates). A lands, then B, and the new
+/// account holds the position. Race: another wallet initialises in between; B is refused 16
+/// EngineProvenanceMismatch (the app's classifier says "race"), and B rebuilt with the REAL id lands.
+#[test]
+fn limits_app_first_trade_one_signature_and_race() {
+    let s = Keypair::new();
+    let (mut w, _) = P3::bound(&[(&s, 10_000_000)], 1_000_000, 1_000);
+    let size: i128 = 100_000;
+
+    // 1. The happy path: A then B, both built before A landed.
+    let u = Keypair::new();
+    w.env.ensure_signer_account(u.pubkey());
+    let src = w.token(u.pubkey(), 2_000_000);
+    let pf = Keypair::new();
+    let v = w.la_first_trade(&u, &pf, src, size, false);
+    println!("LIMITS-APP FIRST-TRADE: next {} predicted {}", v["next"], v["predicted"]);
+    let (a, b) = (la_ixs(&v["a"]), la_ixs(&v["b"]));
+    w.la_send(a, &[&u, &pf]).expect("A: create + InitPortfolio");
+    let (pid, seq, ep) = w.env.portfolio_identity(pf.pubkey());
+    assert_eq!(serde_json::json!(pid.to_string()), v["predicted"], "InitPortfolio assigned the predicted id");
+    assert_eq!((seq, ep), (0, 0), "a fresh portfolio: sequence 0, position epoch 0");
+    w.la_send(b, &[&u]).expect("B: Deposit + TradeCpi at the predicted id");
+    assert_eq!(w.pos(pf.pubkey()), size, "the first trade opened the position");
+    println!("LIMITS-APP FIRST-TRADE: id {pid}, position {}, capital {}", w.pos(pf.pubkey()), w.env.portfolio_state(pf.pubkey()).capital);
+
+    // 2. The race: another wallet initialises between the build and A.
+    let u2 = Keypair::new();
+    w.env.ensure_signer_account(u2.pubkey());
+    let src2 = w.token(u2.pubkey(), 2_000_000);
+    let pf2 = Keypair::new();
+    let v2 = w.la_first_trade(&u2, &pf2, src2, size, false);
+    let (a2, b2) = (la_ixs(&v2["a"]), la_ixs(&v2["b"]));
+    let _other = w.trader(1_000_000); // takes the predicted id
+    w.la_send(a2, &[&u2, &pf2]).expect("A2 lands with the next id");
+    let (pid2, _, _) = w.env.portfolio_identity(pf2.pubkey());
+    assert_ne!(serde_json::json!(pid2.to_string()), v2["predicted"], "vacuity: the id moved");
+    let e = w.la_send(b2, &[&u2]).unwrap_err();
+    assert!(e.contains("Custom(16)"), "B at the stale id is refused EngineProvenanceMismatch: {e}");
+    let cls = la_app("first-trade-classify", serde_json::json!({ "programId": w.env.program_id.to_string(), "market": w.env.market.to_string(), "error": e, "depositIndex": 2 }));
+    assert_eq!(cls["race"], serde_json::json!(true), "the app recognises the race: {cls}");
+    assert_eq!(cls["leg"], serde_json::json!("deposit"), "the refused leg is the deposit: {cls}");
+    let v3 = w.la_first_trade(&u2, &pf2, src2, size, true);
+    assert_eq!(v3["usedId"], serde_json::json!(pid2.to_string()));
+    w.la_send(la_ixs(&v3["b"]), &[&u2]).expect("B rebuilt with the real id lands (the one extra prompt)");
+    assert_eq!(w.pos(pf2.pubkey()), size);
+    conserved(&w, "first trade");
+}
