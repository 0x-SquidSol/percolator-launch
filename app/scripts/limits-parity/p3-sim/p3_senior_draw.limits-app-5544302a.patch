+// ═══════════════════════════════════════════════════════════════════════════════════════
+// limits app (39b138c8 senior draw): APP-BUILT instructions (percolator-launch app/, bridge
+// scripts/limits-parity/p3-app-ixs.ts) on the real wrapper BPF.
+//  - "Earn absorbed": the app's decoder reads senior_draw_outstanding / drawn from real bytes.
+//  - Logs: the app's parser reads p3_senior_draw_restored from a real app-built 75.
+//  - B24 / 88: a senior's app 77 after a draw + recovery is refused 88; the app's 88 repair
+//    (recall-variants: the same list sendTx simulates) inserts 98 before the 77 and the senior
+//    is paid; 75/77 carry the vault LP WRITABLE.
+// ═══════════════════════════════════════════════════════════════════════════════════════
+
+fn la_b64(b: &[u8]) -> String {
+    const T: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut s = String::new();
+    for c in b.chunks(3) {
+        let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32;
+        s.push(T[(n >> 18) as usize & 63] as char);
+        s.push(T[(n >> 12) as usize & 63] as char);
+        s.push(if c.len() > 1 { T[(n >> 6) as usize & 63] as char } else { '=' });
+        s.push(if c.len() > 2 { T[n as usize & 63] as char } else { '=' });
+    }
+    s
+}
+
+fn la_app(cmd: &str, args: serde_json::Value) -> serde_json::Value {
+    let app = std::env::var("LIMITS_APP_DIR").expect("LIMITS_APP_DIR (percolator-launch app/ dir)");
+    let tsx = std::env::var("TSX_BIN").expect("TSX_BIN");
+    let out = std::process::Command::new(tsx)
+        .current_dir(&app)
+        .args(["--tsconfig", "tsconfig.json", "scripts/limits-parity/p3-app-ixs.ts", cmd, &args.to_string()])
+        .output()
+        .expect("spawn app builder");
+    assert!(out.status.success(), "app builder {cmd} failed: {}", String::from_utf8_lossy(&out.stderr));
+    serde_json::from_slice(&out.stdout).expect("app builder json")
+}
+
+fn la_ixs(v: &serde_json::Value) -> Vec<Instruction> {
+    v.as_array()
+        .expect("ixs")
+        .iter()
+        .map(|ix| {
+            let hex = ix["dataHex"].as_str().unwrap();
+            let data = (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect();
+            let accounts = ix["keys"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|k| {
+                    let pk: Pubkey = k["pubkey"].as_str().unwrap().parse().unwrap();
+                    let s = k["isSigner"].as_bool().unwrap();
+                    if k["isWritable"].as_bool().unwrap() { AccountMeta::new(pk, s) } else { AccountMeta::new_readonly(pk, s) }
+                })
+                .collect();
+            Instruction { program_id: ix["programId"].as_str().unwrap().parse().unwrap(), accounts, data }
+        })
+        .collect()
+}
+
+impl P3 {
+    fn la_b64_of(&self, k: &Pubkey) -> String {
+        la_b64(&self.env.svm.get_account(k).map(|a| a.data).unwrap_or_default())
+    }
+    /// Send APP instructions (fee payer = harness payer); returns the program logs.
+    fn la_send(&mut self, ixs: Vec<Instruction>, signers: &[&Keypair]) -> Result<Vec<String>, String> {
+        let payer = self.env.payer.insecure_clone();
+        let mut all = vec![heap_ix(), cu_ix()];
+        all.extend(ixs);
+        let mut s: Vec<&Keypair> = vec![&payer];
+        s.extend_from_slice(signers);
+        self.env.svm.expire_blockhash();
+        let tx = solana_sdk::transaction::Transaction::new_signed_with_payer(&all, Some(&payer.pubkey()), &s, self.env.svm.latest_blockhash());
+        self.env.svm.send_transaction(tx).map(|m| m.logs).map_err(|e| format!("{e:?}"))
+    }
+    fn la_earn_json(&self, user: &Keypair, extra: serde_json::Value) -> serde_json::Value {
+        let mut v = serde_json::json!({
+            "programId": self.env.program_id.to_string(), "market": self.env.market.to_string(), "domain": 0,
+            "user": user.pubkey().to_string(), "lpMint": self.lp_mint.to_string(), "vaultToken": self.env.vault.to_string(),
+            "vaultAuthority": self.env.vault_authority.to_string(), "escrow": self.escrow.to_string(),
+            "marketB64": self.la_b64_of(&self.env.market), "registryB64": self.la_b64_of(&self.registry),
+            "vaultLpStateB64": self.la_b64_of(&self.state_pda), "lpB64": self.la_b64_of(&self.lp),
+        });
+        for (k, x) in extra.as_object().unwrap() { v[k] = x.clone(); }
+        v
+    }
+}
